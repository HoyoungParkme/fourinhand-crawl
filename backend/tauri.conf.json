{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "포인핸드 대형묘 찾기",
  "mainBinaryName": "PawinhandBigCat",
  "version": "0.1.0",
  "identifier": "io.github.hoyoungparkme.pawinhandbigcat",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "포인핸드 대형묘 찾기",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.animal.go.kr https://d12l2mexpetzlh.cloudfront.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HoyoungParkme",
    "copyright": "HoyoungParkme",
    "category": "Utility",
    "shortDescription": "포인핸드에 보호 중인 고양이 가운데 몸무게가 기준 이상인 아이만 보여줍니다",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
